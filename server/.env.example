# PORT is optional locally (falls back to 5000). Render injects its own PORT.
PORT=5000
MONGO_URI=
JWT_SECRET=
GITHUB_TOKEN=
NODE_ENV=production
# CORS allowlist: the FRONTEND origin(s), comma-separated for multiple. Not the
# Render backend URL. Set this in Render to your real deployed frontend domain,
# e.g. CLIENT_URL=https://your-app.vercel.app. Unset defaults to
# http://localhost:5173, which blocks all production browser traffic.
CLIENT_URL=http://localhost:5173
