# Backend origin + API prefix. The /api suffix is REQUIRED: call sites request
# '/auth/login' and '/github/:username' with no prefix, so dropping it here
# produces 404s. VITE_* is baked into the public bundle - public URL only,
# never MONGO_URI / JWT_SECRET / GITHUB_TOKEN.
VITE_API_BASE_URL=http://localhost:5000/api

# Local development (copy this file to .env).
#   VITE_API_BASE_URL=http://localhost:5000/api
#
# Production - set this in Vercel env vars, not in the repo, and REBUILD after
# changing it. Do not include a trailing /api twice; the value is used verbatim.
#   VITE_API_BASE_URL=https://github-analyzer-ndvg.onrender.com/api
